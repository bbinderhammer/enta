********************************************************************************
* Generate the manual's aggregate-data overview tables directly from code
*
* Purpose:
*   Builds the 6 tables of the manual's Aggregate_data.tex (tab:aggr_production,
*   tab:aggr_income,
*   tab:aggr_taxes, tab:aggr_govben, tab:trans_priv, tab:disp_income_use.
*   Pulls per-capita euro values straight from ENTA_aggregates.dta and
*   writes ready-to-paste LaTeX table rows to generated_tables_snippet.tex
*   in the manual folder.
*
* Sign convention (matches how the existing manual tables are built, not
* how ENTA_aggregates.dta stores the numbers): for the Households and
* Corporations columns, flows that leave the sector (taxes paid, benefits
* paid out, transfers paid) are shown negative; flows the sector receives
* are shown positive. The Government column already stores taxes/benefits
* received as positive in the source data. This is a presentation choice,
* applied explicitly below per row - not inferred automatically.
*
* Usage: change refcnt/refyr/prodcnt below, then run. Output values in
* generated_tables_snippet.tex can be pasted directly into the table
* bodies in Aggregate_data.tex (row labels/captions are unchanged).
********************************************************************************

* Paths. $wkdir is set by the setup file; fall back to the current directory
* so this file also runs on its own from the ENTA root.
*
* The setup file is not sourced here: the VID variant (ENTA_setup.do) has a
* redacted $wkdir and would stop the script before it writes anything. This
* file needs nothing from the setup but $wkdir - no adjustaggr, no gensex - so
* it falls back to the current directory when no setup is loaded.
    if "$wkdir"=="" global wkdir "`c(pwd)'"

local refcnt "DE"
local refyr 2023
local prodcnt "DE IE LU"
local outfile "$wkdir/2026_ENTA_Manual_V_2_0_0/generated_tables_snippet.tex"

use ENTA_aggregates/ENTA_aggregates, clear
sort CNT2 YEAR
merge m:1 CNT2 YEAR using ENTA_input_data/ENTA_input_datasets/population0t, keepusing(POP)
keep if _merge==3
drop _merge

gen VALUE = VALAGGR * 1000000 / POP

* Programme: look up one per-capita value, return formatted string (or "" if missing/absent)
* Every call site below passes sign explicitly - CNT2/YEAR/SECTOR/IND is
* assumed to be a unique key in ENTA_aggregates.dta (r(N)>1 is not
* checked for, and would silently average via `sum` below rather than
* erroring, if that assumption is ever violated).
capture program drop getval
program define getval, rclass
    args cnt yr sec ind sign
    qui count if CNT2=="`cnt'" & YEAR==`yr' & SECTOR=="`sec'" & IND=="`ind'"
    if r(N)==0 {
        return local v ""
        exit
    }
    qui sum VALUE if CNT2=="`cnt'" & YEAR==`yr' & SECTOR=="`sec'" & IND=="`ind'"
    local x = r(mean) * `sign'
    return scalar num = `x'
    return local v = strtrim(string(`x', "%12.0fc"))
end

capture file close f
file open f using "`outfile'", write replace

file write f "% Auto-generated by ENTA_generate_manual_tables.do - do not hand-edit, rerun the script instead" _n
file write f "% Reference: `refcnt' `refyr' (production table: `prodcnt' `refyr')" _n _n

**************************************************
* Table: aggr_production (Total economy, DE/IE/LU)
**************************************************
file write f "% ----- tab:aggr_production -----" _n
foreach c of local prodcnt {
    getval `c' `refyr' "Total economy" GDP 1
    local gdp `r(v)'
    getval `c' `refyr' "Total economy" TPSp -1
    local tps `r(v)'
    getval `c' `refyr' "Total economy" CFC -1
    local cfc `r(v)'
    getval `c' `refyr' "Total economy" YEROW 1
    local yerow `r(v)'
    getval `c' `refyr' "Total economy" YPROW 1
    local yprow `r(v)'
    getval `c' `refyr' "Total economy" Y 1
    local y `r(v)'
    file write f "% `c'" _n
    file write f "0 GDP: `gdp'" _n
    file write f "0.1 - TPS: `tps'" _n
    file write f "0.2 - CFC: `cfc'" _n
    file write f "0.3 + YEROW: `yerow'" _n
    file write f "0.4 + YPROW: `yprow'" _n
    file write f "1 Y: `y'" _n
}
file write f _n

**************************************************
* Table: aggr_income (DE, Total economy/HH/Corp/Gov)
**************************************************
file write f "% ----- tab:aggr_income -----" _n
foreach s in "Total economy" "Households" "Corporations" "Government" {
    getval "`refcnt'" `refyr' "`s'" Y 1
    file write f "Y [`s']: `r(v)'" _n
}
foreach v in YEM YE YM YA YP YO {
    getval "`refcnt'" `refyr' "Households" "`v'" 1
    file write f "`v' [Households]: `r(v)'" _n
}
file write f _n

**************************************************
* Table: aggr_taxes (DE) - Households/Corp columns negated (outflow)
**************************************************
file write f "% ----- tab:aggr_taxes -----" _n
* TROW (2.6, below) is looked up only for Government and reused for the
* "Total economy" column too - Total economy has no independent TROW
* indicator in ENTA_aggregates_compilation.do (its own `local indic` list
* around line 736 omits it), since TROW (government-to-ROW transfers) is
* definitionally a Government-only concept - so the two figures are the
* same number by construction, not an independently verified match.
getval "`refcnt'" `refyr' "Households" T -1
local t_hh `r(v)'
getval "`refcnt'" `refyr' "Corporations" T -1
local t_corp `r(v)'
getval "`refcnt'" `refyr' "Government" T 1
local t_gov `r(v)'
file write f "2 Total taxes (TAX): HH=`t_hh' Corp=`t_corp' Gov=`t_gov'" _n
foreach v in TYEM TYA TB TBSPEN TBSN TBPPEN TCON TX {
    getval "`refcnt'" `refyr' "Households" "`v'" -1
    file write f "`v' [Households]: `r(v)'" _n
}
getval "`refcnt'" `refyr' "Government" TROW 1
local trow `r(v)'
file write f "2.6 Government to ROW transfers (TROW): TotalEcon=`trow' Gov=`trow'" _n
file write f _n

**************************************************
* Table: aggr_govben (DE) - already applied by hand (BSH folded into BSX)
**************************************************
file write f "% ----- tab:aggr_govben -----" _n
getval "`refcnt'" `refyr' "Households" BS 1
local bs_hh `r(v)'
getval "`refcnt'" `refyr' "Government" BS -1
local bs_gov `r(v)'
file write f "3 Social benefits, cash (BS): HH=`bs_hh' Gov=`bs_gov'" _n
foreach v in BSPEN BSFAM BSU BSX {
    getval "`refcnt'" `refyr' "Households" "`v'" 1
    file write f "`v' [Households]: `r(v)'" _n
}
file write f _n

**************************************************
* Table: trans_priv (DE) - Households/Corp shown as paid(-)/received(+) per row
**************************************************
file write f "% ----- tab:trans_priv -----" _n
getval "`refcnt'" `refyr' "Households" BPPEN 1
local bppen_hh `r(v)'
local bppen_hh_n = r(num)
getval "`refcnt'" `refyr' "Corporations" BPPEN 1
local bppen_corp `r(v)'
local bppen_corp_n = r(num)
local bppen_tot = strtrim(string(`bppen_hh_n' + `bppen_corp_n', "%12.0fc"))
file write f "4 Funded pensions (BPPEN): TotalEcon=`bppen_tot' HH=`bppen_hh' Corp=`bppen_corp'" _n
getval "`refcnt'" `refyr' "Households" TPSOCfc -1
local tpsocfc_hh `r(v)'
getval "`refcnt'" `refyr' "Corporations" TPSOCfc -1
local tpsocfc_corp `r(v)'
file write f "4.1 Contributions (TPSOCfc): HH=`tpsocfc_hh' Corp=`tpsocfc_corp'" _n
getval "`refcnt'" `refyr' "Households" BPSOCfc 1
local bpsocfc_hh `r(v)'
getval "`refcnt'" `refyr' "Corporations" BPSOCfc 1
local bpsocfc_corp `r(v)'
file write f "4.2 Benefits (BPSOCfc): HH=`bpsocfc_hh' Corp=`bpsocfc_corp'" _n

* NOTE: "Total economy" is not a stored SECTOR for BP/BPPEN - it is the sum
* of Households + Corporations (private sectors); computed here, not looked up.
getval "`refcnt'" `refyr' "Households" BPB 1
local bpb_hh `r(v)'
local bpb_hh_n = r(num)
getval "`refcnt'" `refyr' "Corporations" BPB 1
local bpb_corp `r(v)'
local bpb_corp_n = r(num)
local bpb_tot = strtrim(string(`bpb_hh_n' + `bpb_corp_n', "%12.0fc"))
file write f "5 Private transfers (BP): TotalEcon=`bpb_tot' HH=`bpb_hh' Corp=`bpb_corp'" _n
getval "`refcnt'" `refyr' "Households" TPSOCnfc -1
local tpsocnfc_hh `r(v)'
getval "`refcnt'" `refyr' "Corporations" TPSOCnfc -1
local tpsocnfc_corp `r(v)'
file write f "5.1 Social contr., private (TPSOCnfc): HH=`tpsocnfc_hh' Corp=`tpsocnfc_corp'" _n
getval "`refcnt'" `refyr' "Households" BPSOCnfc 1
local bpsocnfc_hh `r(v)'
getval "`refcnt'" `refyr' "Corporations" BPSOCnfc 1
local bpsocnfc_corp `r(v)'
file write f "5.2 Social benefits, private (BPSOCnfc): HH=`bpsocnfc_hh' Corp=`bpsocnfc_corp'" _n
getval "`refcnt'" `refyr' "Households" BPX 1
local bpx_hh `r(v)'
getval "`refcnt'" `refyr' "Corporations" BPX 1
local bpx_corp `r(v)'
file write f "5.3 Other private transfers (BPX): HH=`bpx_hh' Corp=`bpx_corp'" _n
getval "`refcnt'" `refyr' "Households" BROW 1
local brow_hh `r(v)'
getval "`refcnt'" `refyr' "Corporations" BROW 1
local brow_corp `r(v)'
file write f "5.4 Transfers from ROW (BROW): HH=`brow_hh' Corp=`brow_corp'" _n
file write f _n

**************************************************
* Table: disp_income_use (DE)
**************************************************
file write f "% ----- tab:disp_income_use -----" _n
foreach s in "Total economy" "Households" "Corporations" "Government" {
    getval "`refcnt'" `refyr' "`s'" YDb 1
    file write f "6 Disposable income (YDb) [`s']: `r(v)'" _n
}
foreach v in CGE CGH CGX {
    getval "`refcnt'" `refyr' "Government" "`v'" 1
    file write f "`v' [Government - Public consumption]: `r(v)'" _n
}
foreach v in CH CHE CHH CHR CHX {
    getval "`refcnt'" `refyr' "Households" "`v'" 1
    file write f "`v' [Households - Private consumption]: `r(v)'" _n
}
* Household saving is published as SH; the other sectors keep S.
* SECTOR disambiguates S for corporations, government and the total economy,
* so only the Households row was renamed. Reading S for Households returns
* nothing - getval is silent on a missing row, so the cell would come out
* blank rather than erroring.
foreach s in "Total economy" "Households" "Corporations" "Government" {
    local sind = cond("`s'"=="Households", "SH", "S")
    getval "`refcnt'" `refyr' "`s'" "`sind'" 1
    file write f "9 Saving (`sind') [`s']: `r(v)'" _n
}

file close f

display ""
display "Written to `outfile'"
